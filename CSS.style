/* KHARAFA MOÇAMBIQUE - Style Oficial */
@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap');

:root{
  --preto: #0a0a0a;
  --bege: #f5f1e8;
  --dourado: #c9a86a;
  --verde-moc: #007168;
  --branco: #ffffff;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family: 'Outfit', sans-serif;
}

body{
  background: var(--bege);
  color: var(--preto);
}

/* HEADER */
header{
  background: var(--preto);
  color: var(--branco);
  padding: 18px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  position:sticky;
  top:0;
  z-index:100;
}

header h1{
  letter-spacing: 4px;
  font-weight:800;
  font-size:22px;
}
header h1 span{
  color: var(--dourado);
}

header nav a{
  color: var(--branco);
  text-decoration:none;
  margin-left:20px;
  font-size:14px;
  opacity:0.8;
}
header nav a:hover{
  color: var(--dourado);
  opacity:1;
}

/* HERO */
.hero{
  background: var(--preto);
  color: var(--branco);
  padding: 80px 6%;
  text-align:center;
}

.hero h2{
  font-size: 48px;
  font-weight:800;
  line-height:1;
  margin-bottom:15px;
}
.hero h2 em{
  color: var(--dourado);
  font-style:normal;
}
.hero p{
  opacity:0.6;
  margin-bottom:25px;
}
.btn{
  background: var(--dourado);
  color: var(--preto);
  padding: 14px 32px;
  border:none;
  border-radius:30px;
  font-weight:700;
  cursor:pointer;
  display:inline-block;
  text-decoration:none;
}

/* PRODUTOS */
.produtos{
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap:20px;
  padding: 40px 6%;
}

.card{
  background: var(--branco);
  border-radius:18px;
  overflow:hidden;
  padding-bottom:15px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  transition:0.3s;
}
.card:hover{
  transform: translateY(-5px);
}
.card img{
  width:100%;
  height:220px;
  object-fit:cover;
}
.card h3{
  padding:12px 12px 2px;
  font-size:16px;
}
.card .preco{
  padding:0 12px;
  color: var(--verde-moc);
  font-weight:800;
}

/* FOOTER */
footer{
  background: var(--preto);
  color: var(--branco);
  padding:40px 6%;
  text-align:center;
  margin-top:40px;
  opacity:0.9;
}
footer p{
  font-size:12px;
  opacity:0.5;
  margin-top:10px;
}
